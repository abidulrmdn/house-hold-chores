rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Profile pictures - users can upload/read their own, household members can read
    match /profile-pictures/{userId}/{allPaths=**} {
      // Allow users to upload their own profile pictures
      allow write: if request.auth != null && request.auth.uid == userId;
      // Allow users to read their own profile pictures
      // Allow household members to read profile pictures (for displaying assigned user photos)
      allow read: if request.auth != null;
    }
  }
}

