rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rate limiting collection (for AI functions)
    match /rateLimits/{document} {
      allow read, write: if request.auth != null;
    }
    // Users can read/write their own user document
    // Users can also read other users in the same household
    match /users/{userId} {
      allow read: if request.auth != null && 
        (request.auth.uid == userId || 
         (resource.data.householdId != null && 
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == resource.data.householdId));
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Households - anyone authenticated can read (to check if exists for joining)
    // Members can read, creator can write, members can update to add themselves
    match /households/{householdId} {
      // Allow read if authenticated (needed for joining)
      allow read: if request.auth != null;
      // Allow create if authenticated
      allow create: if request.auth != null;
      // Allow update if creator OR if adding self to members
      allow update: if request.auth != null && 
        (request.auth.uid == resource.data.createdBy ||
         (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members']) &&
          request.resource.data.members.hasAll(resource.data.members) &&
          request.resource.data.members.hasAny([request.auth.uid])));
      // Only creator can delete
      allow delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // Categories - household members can read/write
    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
    
    // Routines - household members can read, creator can write
    match /routines/{routineId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && 
        request.auth.uid == resource.data.createdBy;
    }
    
    // Task instances - household members can read and update
    match /taskInstances/{taskId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      // Allow update if user is in the same household
      allow update: if request.auth != null && 
        (resource.data.householdId != null &&
         exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.householdId == resource.data.householdId);
    }
  }
}

